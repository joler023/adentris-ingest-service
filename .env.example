PORT=3000
MONGODB_URI=mongodb://localhost:27017/ingest
RABBITMQ_URL=amqp://localhost:5672

# Number of per-patient queues. Must be identical in api and worker, and only
# changed while the queues are drained (see docs/ARCHITECTURE.md).
PARTITIONS=256

# Backoff between attempts; max attempts = number of delays + 1.
RETRY_DELAYS_MS=5000,30000,120000

# Simulated external system.
EXTERNAL_PROCESSING_MS=5000
EXTERNAL_FAILURE_RATE=0
EXTERNAL_TIMEOUT_MS=20000

# A PROCESSING event whose lease expired may be taken over (must exceed the timeout).
LEASE_MS=30000
